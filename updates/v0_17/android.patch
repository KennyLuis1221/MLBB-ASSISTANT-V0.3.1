+    private fun decodeFrame(image: Image): Bitmap {
+        val plane = image.planes.first()
+        val rowBytes = image.width * 4
+        val input = plane.buffer
+        require(plane.pixelStride == 4 && plane.rowStride >= rowBytes)
+        require(input.remaining().toLong() >= (image.height - 1L) * plane.rowStride + rowBytes)
+        val pixels = if (plane.rowStride == rowBytes) {
+            input
+        } else {
+            val result = ByteBuffer.allocate(rowBytes * image.height)
+            val start = input.position()
+            for (y in 0 until image.height) {
+                val offset = start + y * plane.rowStride
+                input.limit(offset + rowBytes)
+                input.position(offset)
+                result.put(input)
+            }
+            result.flip()
+            result
+        }
+        val original = Bitmap.createBitmap(image.width, image.height, Bitmap.Config.ARGB_8888)
+        try {
+            original.copyPixelsFromBuffer(pixels)
+            val ratio = (1920f / maxOf(image.width, image.height)).coerceAtMost(1f)
+            return if (ratio == 1f) original else Bitmap.createScaledBitmap(
+                original, (image.width * ratio).toInt().coerceAtLeast(1),
+                (image.height * ratio).toInt().coerceAtLeast(1), true
+            ).also { original.recycle() }
+        } catch (error: Exception) {
+            original.recycle()
+            throw error
+        }
+    }
