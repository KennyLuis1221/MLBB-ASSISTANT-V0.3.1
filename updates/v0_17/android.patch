+    private fun call(url: String, method: String): JSONObject {
+        val connection = URL(url).openConnection() as HttpURLConnection
+        try {
+            connection.instanceFollowRedirects = false
+            connection.requestMethod = method
+            connection.connectTimeout = 5_000
+            connection.readTimeout = 5_000
+            connection.setRequestProperty("Accept", "application/json")
+            if (method == "POST") {
+                connection.doOutput = true
+                connection.setFixedLengthStreamingMode(0)
+                connection.outputStream.close()
+            }
+            val code = connection.responseCode
+            if (code !in 200..299) throw CloudHttpError(code)
+            val buffer = CharArray(4_097)
+            return connection.inputStream.bufferedReader().use { reader ->
+                var size = 0
+                while (size < buffer.size) {
+                    val count = reader.read(buffer, size, buffer.size - size)
+                    if (count < 0) break
+                    size += count
+                }
+                require(size < buffer.size)
+                JSONObject(String(buffer, 0, size))
+            }
+        } finally {
+            connection.disconnect()
+        }
     }
 }
